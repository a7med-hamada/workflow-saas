{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "{migrations/**,public/**,src/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js?__wf_path=/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.js?__wf_path=/$1"
    }
  ]
}
