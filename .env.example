# Server Configuration
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# Database Configuration
# Local SQLite database path (used automatically by default)
DATABASE_PATH=./data/workflow.sqlite
# Optional PostgreSQL connection URL for external production deployments
DATABASE_URL=postgresql://postgres:password@localhost:5432/workflow

# Security & Session Configuration
SESSION_SECRET=change-this-to-a-long-random-production-secret-key-64-chars
SESSION_TTL_HOURS=168
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_ATTEMPTS=25

# File Storage Configuration
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_SIZE_MB=10

# Background Jobs & Reminders
REMINDER_INTERVAL_MS=60000

# Optional Email Provider Configuration (SMTP)
# When not configured in development mode, invitation and password-reset links
# are safely returned via the development helper banner.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@workflow.example.com
